  m_FallbackFontAssetTable:
  - {fileID: 11400000, guid: 0dc16dec149ee334eb4c79400f5786d1, type: 2}
  - {fileID: 11400000, guid: e434f268994e58f4b91e6025034c2a2f, type: 2}
  m_CreationSettings:
    sourceFontFileName: 
    sourceFontFileGUID: 6d07ecf389644054d84683722f6a564d
    pointSizeSamplingMode: 0
    pointSize: 103
    padding: 8
    packingMode: 0
    atlasWidth: 1024
    atlasHeight: 1024
    characterSetSelectionMode: 8
    characterSequence: "//others\r\n\uD55C\uAD6D\uC5B4\r\n\r\n3\r\n[Ungroupped]\r\n#
      REAM ME:\r\n# The format used here is derived from INI.\r\n# We have added
      something special called variants.\r\n# \r\n# Example:\r\n# \r\n# [Planets]\r\n#
      Earth{0}= \uC9C0\uAD6C\r\n# Earth{1}= \uC9C0\uAD6C\uC758\r\n# \r\n# [Achievements]\r\n#
      Landed_Test0 = %planet{0}%\uC5D0 \uCC29\uB959\uD568\r\n# Landed_Test1 = %planet{1}%\uC5D0
      \uCC29\uB959\uD568\r\n# \r\n# Variants are used for many things, such as making
      phrases work, caps, etc\r\n# \r\n# We recommend starting at the bottom of the
      file with achievements/planets, there variants are very clearly used.\r\n#
      \r\n# \r\n# \r\n# Available font types: normal/compatibility\r\n# In case of
      missing characters use compatibility font.\r\n    Font=\uD45C\uC900\r\n\r\n[General]\r\n#
      Used for language select buttons\r\n    Language_Name_In_Local_Language=\uC601\uC5B4\r\n\r\n   
      Cancel=\uCDE8\uC18C\r\n    Close=\uC885\uB8CC\r\n\r\n    Open_Settings_Button=\uC124\uC815\r\n\r\n#
      Switching scenes buttons\r\n    Build_Rocket=\uB85C\uCF13 \uAD6C\uCD95\r\n   
      Resume_Game=\uAC8C\uC784 \uACC4\uC18D\r\n    Return_To_Main_Menu=\uBA54\uC778
      \uBA54\uB274\r\n    Exit_To_Main_Menu=\uBA54\uC778 \uBA54\uB274\uB85C \uB098\uAC00\uAE30\r\n\r\n[Main
      Menu]\r\n# Image at: https://drive.google.com/file/d/1mEFf3W964ldXBekpbTc-Jj1XcSnBQz4k/view?usp=sharing\r\n   
      Play=\uD50C\uB808\uC774\r\n\r\n# Tutorial\r\n    Video_Tutorials_OpenButton=\uB3D9\uC601\uC0C1
      \uD29C\uD1A0\uB9AC\uC5BC\r\n    Video_Orbit=\uADA4\uB3C4 \uD29C\uD1A0\uB9AC\uC5BC\r\n   
      Video_Moon=\uB2EC \uD29C\uD1A0\uB9AC\uC5BC\r\n    Video_Dock=\uB3C4\uD0B9 \uD29C\uD1A0\uB9AC\uC5BC\r\n\r\n#
      Community\r\n    Community_OpenButton=\uCEE4\uBBA4\uB2C8\uD2F0\r\n    Community_Youtube=Youtube\r\n   
      Community_Discord=Discord\r\n    Community_Reddit=Reddit\r\n\r\n# Roadmap\r\n   
      Roadmap_OpenButton=\uD5A5\uD6C4 \uC5C5\uB370\uC774\uD2B8\r\n\r\n    Roadmap_Text=\uBC84\uC804
      1.51\r\n    Roadmap_Text=<color=grey>\uC2A4\uD14C\uC774\uC9C0</color>\r\n   
      Roadmap_Text=\r\n    Roadmap_Text=\uBC84\uC804 1.52\r\n    Roadmap_Text=<color=grey>\uD29C\uD1A0\uB9AC\uC5BC</color>\r\n   
      Roadmap_Text=\r\n    Roadmap_Text=\uBC84\uC804 1.53\r\n    Roadmap_Text=<color=grey>\uC7AC\uC785\uC7A5</color>\r\n   
      Roadmap_Text=\r\n    Roadmap_Text=\uBC84\uC804 1.54\r\n    Roadmap_Text=<color=grey>\uC2DC\uAC01
      \uD6A8\uACFC, \uC785\uC790 \uBC0F \uC18C\uB9AC</color>\r\n    Roadmap_Text=\r\n   
      Roadmap_Text=\uBC84\uC804 1.55\r\n    Roadmap_Text=<color=grey>\uACE0\uCCB4
      \uB85C\uCF13 \uBD80\uC2A4\uD130</color>\r\n    Roadmap_Text=\r\n    Roadmap_Text=\uBC84\uC804
      1.6\r\n    Roadmap_Text=<color=grey>\uC6B0\uC8FC \uBE44\uD589\uC0AC</color>\r\n   
      Roadmap_Text=\r\n    Roadmap_Text=\uBC84\uC804 1.7\r\n    Roadmap_Text=<color=grey>\uCEE4\uB9AC\uC5B4</color>\r\n   
      Roadmap_Text=\r\n    Roadmap_Text=\uBC84\uC804 1.8\r\n    Roadmap_Text=<color=grey>\uC678\uACC4
      \uD589\uC131</color>\r\n    Roadmap_Text=\r\n    Roadmap_Text=\uC804\uAE30
      \uC2DC\uC2A4\uD15C:\r\n    Roadmap_Text=<color=grey>\uC804\uCCB4 \uC804\uAE30
      \uC2DC\uC2A4\uD15C\uC774 \uD5A5\uD6C4 \uC644\uC804\uD788 \uC815\uBE44\uB420
      \uC608\uC815\uC774\uBA70, \uC774\uC628 \uC5D4\uC9C4 \uC5F0\uC18C \uC2DC\uC758
      \uD0C0\uC784 \uC6CC\uD504, \uADF8\uB9AC\uACE0 \uB354 \uB9CE\uC740 \uC804\uAE30
      \uC0AC\uC6A9 \uC0AC\uB840 \uB4F1\uC758 \uAE30\uB2A5\uC744 \uD3EC\uD568\uD560
      \uD655\uB960\uC774 \uB192\uB2F5\uB2C8\uB2E4.</color>\r\n    Roadmap_Text=\r\n   
      Roadmap_Text=\r\n    Roadmap_Text=\uACC4\uD68D\uC740 \uBCC0\uACBD\uB420 \uC218
      \uC788\uC2B5\uB2C8\uB2E4.\r\n\r\n# Credits\r\n    Credits_OpenButton=\uAC10\uC0AC\uC758
      \uB9D0\r\n\r\n    Credits_Text=\u0160tefo Mai Morojna\r\n    Credits_Text=<Size=55>\uB514\uC790\uC774\uB108
      \u2013 \uD504\uB85C\uADF8\uB798\uBA38 - \uC544\uD2F0\uC2A4\uD2B8</size>\r\n   
      Credits_Text=\r\n    Credits_Text=Jordi van der Molen\r\n    Credits_Text=<Size=55>\uD504\uB85C\uADF8\uB798\uBA38</size>\r\n   
      Credits_Text=\r\n    Credits_Text=Chris Christo\r\n    Credits_Text=<Size=55>\uD504\uB85C\uADF8\uB798\uBA38</size>\r\n   
